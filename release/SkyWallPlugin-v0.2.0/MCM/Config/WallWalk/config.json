        { "id": "enabled", "name": "Enable Plugin", "type": "toggle", "default": true },
        { "id": "hotkey", "name": "Wall-Walk Hotkey", "type": "keymap", "default": 21 },
        { "id": "disableInCombat", "name": "Disable In Combat", "type": "toggle", "default": false },
        { "id": "debugLogState", "name": "Log State Changes", "type": "toggle", "default": false }
      ]
    },
    {
