      "name": "$Movement",
      "items": [
        { "id": "maxAttachDistance", "name": "Attach Distance", "type": "slider", "default": 3000.0, "min": 100.0, "max": 10000.0, "step": 50.0 },
        { "id": "maxCeilingAttachDistance", "name": "Ceiling Attach Distance", "type": "slider", "default": 3000.0, "min": 100.0, "max": 10000.0, "step": 50.0 },
        { "id": "minAttachSpeed", "name": "Minimum Attach Speed", "type": "slider", "default": 30.0, "min": 0.0, "max": 500.0, "step": 5.0 },
        { "id": "adhesionStrength", "name": "Adhesion Strength", "type": "slider", "default": 600.0, "min": 100.0, "max": 3000.0, "step": 50.0 },
        { "id": "gravityMagnitude", "name": "Gravity Magnitude", "type": "slider", "default": 1000.0, "min": 100.0, "max": 5000.0, "step": 50.0 },
        { "id": "edgeTransferBlendTime", "name": "Edge Blend Time", "type": "slider", "default": 0.12, "min": 0.02, "max": 1.0, "step": 0.01 },
